# Install on staging host:
#   sudo cp /var/www/staging-api/scripts/staging-api.service.example /etc/systemd/system/staging-api.service
#   sudo systemctl daemon-reload && sudo systemctl enable staging-api && sudo systemctl restart staging-api
#
# Each worker has its own SQLAlchemy pool — use DATABASE_POOL_SIZE + MAX_OVERFLOW such that:
#   workers * (POOL_SIZE + MAX_OVERFLOW) stays below Postgres max_connections (see .env.example).

[Unit]
Description=Staging Supershyft FastAPI
After=network.target

[Service]
User=pita-ihsir
Group=pita-ihsir
WorkingDirectory=/var/www/staging-api
Environment="PATH=/var/www/staging-api/venv/bin"
EnvironmentFile=/var/www/staging-api/.env
ExecStart=/var/www/staging-api/venv/bin/uvicorn main:app --host 127.0.0.1 --port 8102 --workers 4
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target