      "id": "3dd40037-2346-44ce-90a3-f62a6386e2dc",
      "name": "Validate Payload"
    },
    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body;\nconst notificationId = body.notification_id;\nconst pd = body.participant_details || {};\nreturn body.members.map(member => ({\n  json: {\n    notification_id: notificationId,\n    first_name: member.first_name || '',\n    last_name: member.last_name || '',\n    email: member.email || '',\n    phone: member.phone || '',\n    participant_details: pd\n  }\n}));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        5020,
        4880
      ],
      "id": "5722274b-d7eb-494b-a517-9a2cc3a4e582",
      "name": "Split Members"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const item = $input.item.json;\nconst pd = item.participant_details || {};\nconst bookerName = (pd.booker_name || item.first_name || 'there').trim();\nconst recipientName = (pd.recipient_name || '-').trim();\nconst relationship = (pd.relationship || '-').trim();\nconst giftUrl = (pd.gift_url || 'https://app.supershyft.com').trim();\nlet phone = String(item.phone || '').replace(/\\D/g, '');\nif (phone.length === 10) phone = '91' + phone;\nconst message = `REPLACE_SENDER_TEMPLATE,${bookerName},${recipientName},${relationship},${giftUrl}`;\nreturn { json: { notification_id: item.notification_id, phone, message } };"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        5240,
        4880
      ],
      "id": "74f48946-6beb-4a6c-8cb3-d4bf675e5752",
      "name": "Prepare WhatsApp"
    },
