{
  "nodes": [
    {
      "parameters": {
        "content": "## Booking Confirmation Email\nSends blood-collection booking confirmation email when Healthians status_updated / BS005 (new booking) is received and SuperShyft dispatches this service.\n\nRequired payload:\n{\n  notification_id: number,\n  members: [{\n    first_name, last_name, email, phone,\n    session_details: { want, date, slot, expert_type, cabin? }\n  }],\n  engagement_id?: number\n}\n\nNotification service must have require_session_details enabled.\nMaps: date → Collection_Date, slot → Collection_Time (range e.g. \"10:00 AM to 11:00 AM\"), cabin → Cabin_Name (omit when empty).",
        "height": 560,
        "width": 1984
      },
      "type": "n8n-nodes-base.stickyNote",
      "position": [
        4432,
        2528
      ],
      "typeVersion": 1,
      "id": "bce-node-0000-sticky",
      "name": "Sticky Note Booking Confirmation Email"
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "booking-confirmation-email-v1",
        "options": {}
      },
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [
        4544,
        2752
      ],
      "id": "bce-node-0001-webhook",
      "name": "Booking Confirmation Email",
      "webhookId": "bce-wh-booking-confirmation-email"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 3
          },
          "conditions": [
            {
              "id": "bce-cond-notif",
              "leftValue": "={{ $json.body.notification_id }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "exists",
                "singleValue": true
              }
            },
            {
              "id": "bce-cond-members",
              "leftValue": "={{ $json.body.members }}",
              "rightValue": "",
              "operator": {
                "type": "array",
