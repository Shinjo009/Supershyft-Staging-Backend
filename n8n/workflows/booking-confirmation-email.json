                "singleValue": true
              }
            },
            {
              "id": "bce-cond-len",
              "leftValue": "={{ $json.body.members.length }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            },
            {
              "id": "bce-cond-sd",
              "leftValue": "={{ $json.body.members[0].session_details }}",
              "rightValue": "",
              "operator": {
                "type": "object",
                "operation": "exists",
                "singleValue": true
              }
            },
            {
              "id": "bce-cond-date",
              "leftValue": "={{ $json.body.members[0].session_details.date }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "exists",
                "singleValue": true
              }
            },
            {
              "id": "bce-cond-slot",
              "leftValue": "={{ $json.body.members[0].session_details.slot }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "exists",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        4784,
        2752
      ],
      "id": "bce-node-0002-validate",
      "name": "Validate Email Payload"
    },
    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body;\nconst notificationId = body.notification_id;\n\nreturn body.members\n  .filter((member) => member.session_details && member.session_details.want !== false)\n  .map((member) => ({\n    json: {\n      notification_id: notificationId,\n      first_name: member.first_name || 'Participant',\n      last_name: member.last_name || '',\n      email: member.email || '',\n      phone: member.phone || '',\n      session_details: {\n        want: Boolean(member.session_details.want),\n        date: member.session_details.date || '',\n        slot: member.session_details.slot || '',\n        expert_type: member.session_details.expert_type || 'blood_collection',\n        cabin: member.session_details.cabin || ''\n      }\n    }\n  }));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        4992,
        2640
      ],
      "id": "bce-node-0003-split",
      "name": "Split Members"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const member = $input.item.json;\nconst name = (member.first_name || 'Participant').trim();\nconst collectionDate = (member.session_details?.date || '').trim();\nconst collectionTime = (member.session_details?.slot || '').trim();\nconst cabinRaw = member.session_details?.cabin;\nconst cabinName = (cabinRaw == null || cabinRaw === undefined ? '' : String(cabinRaw)).trim();\n\nconst cabinLine = cabinName ? `\\nCabin: ${cabinName}` : '';\nconst body = `Hello ${name},\\n\\nYour blood collection booking has been successfully confirmed.\\n\\nDate: ${collectionDate}\\nTime: ${collectionTime}${cabinLine}\\n\\nWe look forward to supporting you on your preventive health journey.\\n\\nYou can check your details anytime at: app.supershyft.com\\n\\nWarm regards,\\nTeam Supershyft`;\n\nreturn {\n  json: {\n    notification_id: member.notification_id,\n    to: member.email,\n    subject: 'Your SuperShyft booking is confirmed',\n    body\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        5216,
        2640
      ],
      "id": "bce-node-0004-prepare",
      "name": "Prepare Booking Confirmation Email"
    },
    {
      "parameters": {
        "fromEmail": "support@supershyft.com",
        "toEmail": "={{ $json.to }}",
        "subject": "={{ $json.subject }}",
        "emailFormat": "text",
        "text": "={{ $json.body }}",
        "options": {
          "appendAttribution": false
        }
      },
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        5456,
        2640
      ],
      "id": "bce-node-0005-send",
