      "name": "Validate Payload"
    },
    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body;\nconst notificationId = body.notification_id;\nconst pd = body.participant_details || {};\nreturn body.members.map(member => ({\n  json: {\n    notification_id: notificationId,\n    first_name: member.first_name || '',\n    last_name: member.last_name || '',\n    email: member.email || '',\n    phone: member.phone || '',\n    participant_details: pd\n  }\n}));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        5020,
        4880
      ],
      "id": "90fe1d0d-5523-42cc-8e91-9623270d0463",
      "name": "Split Members"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const item = $input.item.json;\nconst pd = item.participant_details || {};\nconst recipientName = (pd.recipient_name || item.first_name || 'there').trim();\nconst bookerName = (pd.booker_name || '-').trim();\nconst giftUrl = (pd.gift_url || 'https://app.supershyft.com').trim();\nlet phone = String(item.phone || '').replace(/\\D/g, '');\nif (phone.length === 10) phone = '91' + phone;\nconst message = `REPLACE_RECEIVER_TEMPLATE,${recipientName},${bookerName},${giftUrl}`;\nreturn { json: { notification_id: item.notification_id, phone, message } };"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        5240,
        4880
      ],
      "id": "43fc36cd-3e0d-4bb3-acf4-a64d5f18e2c9",
