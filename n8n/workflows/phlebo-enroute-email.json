{
  "nodes": [
    {
      "parameters": {
        "content": "## Phlebo Enroute Email\\nHealthians phlebo webhook participant notification. Requires participant_details; session_details when assigned/reassigned.",
        "height": 560,
        "width": 1984
      },
      "type": "n8n-nodes-base.stickyNote",
      "position": [
        4432,
        2528
      ],
      "typeVersion": 1,
      "id": "pe-em-sticky",
      "name": "Sticky Note Phlebo Enroute Email"
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "phlebo-enroute-email-v1",
        "options": {}
      },
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [
        4544,
        2752
      ],
      "id": "pe-em-webhook",
      "name": "Phlebo Enroute Email",
      "webhookId": "pe-wh-enroute-em"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 3
          },
          "conditions": [
            {
              "id": "pe-em-cond-notif",
              "leftValue": "={{ $json.body.notification_id }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "exists",
                "singleValue": true
              }
            },
            {
              "id": "pe-em-cond-members",
              "leftValue": "={{ $json.body.members }}",
              "rightValue": "",
              "operator": {
                "type": "array",
                "operation": "exists",
                "singleValue": true
              }
            },
            {
              "id": "pe-em-cond-len",
              "leftValue": "={{ $json.body.members.length }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            },
            {
              "id": "pe-em-cond-pd",
              "leftValue": "={{ $json.body.participant_details }}",
              "rightValue": "",
              "operator": {
                "type": "object",
                "operation": "exists",
                "singleValue": true
              }
            },
            {
              "id": "pe-em-cond-phlebo",
              "leftValue": "={{ $json.body.participant_details.phlebo_name }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "exists",
                "singleValue": true
              }
            },
            {
              "id": "pe-em-cond-track",
              "leftValue": "={{ $json.body.participant_details.tracking_url }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "exists",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        4784,
        2752
      ],
      "id": "pe-em-validate",
      "name": "Validate Email Payload"
    },
    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body;\nconst notificationId = body.notification_id;\nconst pd = body.participant_details || {};\n\nreturn body.members.map((member) => ({\n  json: {\n    notification_id: notificationId,\n    first_name: member.first_name || 'Participant',\n    last_name: member.last_name || '',\n    email: member.email || '',\n    phone: member.phone || '',\n    participant_details: pd,\n    session_details: member.session_details || null\n  }\n}));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        4992,
        2640
      ],
      "id": "pe-em-split",
      "name": "Split Members"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const member = $input.item.json;\nconst name = (member.first_name || 'Participant').trim();\nconst pd = member.participant_details || {};\nconst phleboName = (pd.phlebo_name || 'Phlebotomist').trim();\nconst masked = (pd.masked_number || '').trim();\nconst tracking = (pd.tracking_url || '').trim();\nconst body = `Hello ${name},\\n\\nYour phlebotomist ${phleboName} is on the way for your blood collection.\\n\\nContact: ${masked}\\nTrack: ${tracking}\\n\\nYou can check your details anytime at: app.supershyft.com\\n\\nWarm regards,\\nTeam Supershyft`;\nreturn { json: { notification_id: member.notification_id, to: member.email, subject: 'Your phlebotomist is on the way', body } };"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        5216,
        2640
      ],
      "id": "pe-em-prepare",
      "name": "Prepare Phlebo Enroute Email"
    },
    {
      "parameters": {
        "fromEmail": "support@supershyft.com",
        "toEmail": "={{ $json.to }}",
        "subject": "={{ $json.subject }}",
        "emailFormat": "text",
        "text": "={{ $json.body }}",
        "options": {
          "appendAttribution": false
        }
      },
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        5456,
        2640
      ],
      "id": "pe-em-send",
      "name": "Send Phlebo Enroute Email",
      "retryOnFail": true,
      "waitBetweenTries": 3000,
      "webhookId": "pe-em-smtp",
      "credentials": {
        "smtp": {
          "id": "eCub7Y6RwBvqnurK",
          "name": "SMTP account"
        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "pe-em-sent-id",
              "name": "notification_id",
              "value": "={{ $('Prepare Phlebo Enroute Email').item.json.notification_id }}",
              "type": "number"
            },
            {
              "id": "pe-em-sent-status",
              "name": "status",
              "value": "sent",
              "type": "string"
            },
            {
              "id": "pe-em-sent-msg",
              "name": "message",
              "value": "Email sent successfully",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        5696,
        2560
      ],
      "id": "pe-em-sent",
      "name": "Email Sent Response"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "pe-em-fail-id",
              "name": "notification_id",
              "value": "={{ $json.notification_id }}",
              "type": "number"
            },
            {
              "id": "pe-em-fail-status",
              "name": "status",
              "value": "failed",
              "type": "string"
            },
            {
              "id": "pe-em-fail-msg",
              "name": "message",
              "value": "Email sending failed",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        5696,
        2736
      ],
      "id": "pe-em-fail",
      "name": "Email Failed Response"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "pe-em-val-id",
              "name": "notification_id",
              "value": "={{ $('Phlebo Enroute Email').item.json.body.notification_id }}",
              "type": "number"
            },
            {
              "id": "pe-em-val-status",
              "name": "status",
              "value": "failed",
              "type": "string"
            },
            {
              "id": "pe-em-val-msg",
              "name": "message",
              "value": "Payload validation failed: notification_id, members, and participant_details are required",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        4992,
        2880
      ],
      "id": "pe-em-valfail",
      "name": "Email Validation Failed"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.supershyft.com/notifications/callback",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"notification_id\": {{ $json.notification_id }},\n  \"status\": \"{{ $json.status }}\",\n  \"message\": \"{{ $json.message }}\"\n}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        6128,
        2880
      ],
      "id": "pe-em-callback",
      "name": "Email Callback",
      "alwaysOutputData": true,
      "retryOnFail": true,
      "credentials": {
        "httpHeaderAuth": {
          "id": "djiMPtATquR2OnRc",
          "name": "Notification Header Auth | api.supershyft"
        }
      },
      "onError": "continueRegularOutput"
    }
  ],
