                "operation": "exists",
                "singleValue": true
              }
            },
            {
              "id": "3",
              "leftValue": "={{ $json.body.participant_details }}",
              "rightValue": "",
              "operator": {
                "type": "object",
                "operation": "exists",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        4800,
        2800
      ],
      "id": "d0b94d19-7885-49be-b650-3cc6010413e2",
      "name": "Validate Payload"
    },
    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body;\nconst notificationId = body.notification_id;\nconst pd = body.participant_details || {};\nreturn body.members.map(member => ({\n  json: {\n    notification_id: notificationId,\n    first_name: member.first_name || '',\n    last_name: member.last_name || '',\n    email: member.email || '',\n    phone: member.phone || '',\n    participant_details: pd\n  }\n}));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        5020,
        2680
      ],
      "id": "77f5399e-ebc7-4bc7-851b-774d019f8db9",
      "name": "Split Members"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const item = $input.item.json;\nconst pd = item.participant_details || {};\nconst bookerName = (pd.booker_name || item.first_name || 'there').trim();\nconst recipientName = (pd.recipient_name || '-').trim();\nconst relationship = (pd.relationship || '-').trim();\nconst giftUrl = (pd.gift_url || 'https://app.supershyft.com').trim();\nconst body = `Hello ${bookerName},\n\nThis Diwali you are giving someone you love something truly special through the gift of health and well being.\n\nYour personalised BIO AI Wellness Assessment for ${recipientName} is being created with love.\n\nRecipient Name: ${recipientName}\nRelationship: ${relationship}\n\nBecause the people we love deserve a healthier and happier life with many more beautiful moments together.\n\nYou can check the details below for your convenience.\n\n${giftUrl}\n\nThank you for choosing to make someone's well being a little more special this Diwali.\n\nWishing you and your family a beautiful Diwali filled with love happiness and good health.\n\nWarm regards\nTeam Supershyft`;\nreturn { json: { notification_id: item.notification_id, to: item.email, subject: 'Your Diwali gift of health from Supershyft', body } };"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        5240,
        2680
      ],
      "id": "789e31d8-3151-4112-830f-982d3492535b",
      "name": "Prepare Email"
    },
    {
      "parameters": {
        "fromEmail": "support@supershyft.com",
        "toEmail": "={{ $json.to }}",
        "subject": "={{ $json.subject }}",
        "emailFormat": "text",
        "text": "={{ $json.body }}",
        "options": {
          "appendAttribution": false
        }
      },
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        5460,
        2680
      ],
      "id": "262f4d1c-d8bb-4cde-ba7c-38baf08018f1",
      "name": "Send Email",
      "retryOnFail": true,
      "waitBetweenTries": 3000,
      "credentials": {
        "smtp": {
          "id": "eCub7Y6RwBvqnurK",
          "name": "SMTP account"
        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
