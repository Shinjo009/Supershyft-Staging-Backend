{
  "nodes": [
    {
      "parameters": {
        "content": "## CPU Overload Email\nWebhook path: /cpu_above_threshold\nSends an alert email with subject and body: CPU Overload.\n\nRequired payload:\n{\n  notification_id: number,\n  members: [{ email }]\n}",
        "height": 560,
        "width": 1984
      },
      "type": "n8n-nodes-base.stickyNote",
      "position": [
        4432,
        2528
      ],
      "typeVersion": 1,
      "id": "coe-node-0000-sticky",
      "name": "Sticky Note CPU Overload Email"
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "cpu_above_threshold",
        "options": {}
      },
      "type": "n8n-nodes-base.webhook",
