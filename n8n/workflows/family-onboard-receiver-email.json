              }
            },
            {
              "id": "3",
              "leftValue": "={{ $json.body.participant_details }}",
              "rightValue": "",
              "operator": {
                "type": "object",
                "operation": "exists",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        4800,
        2800
      ],
      "id": "840c7179-54a5-476e-a5e2-9688d3800284",
      "name": "Validate Payload"
    },
    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body;\nconst notificationId = body.notification_id;\nconst pd = body.participant_details || {};\nreturn body.members.map(member => ({\n  json: {\n    notification_id: notificationId,\n    first_name: member.first_name || '',\n    last_name: member.last_name || '',\n    email: member.email || '',\n    phone: member.phone || '',\n    participant_details: pd\n  }\n}));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        5020,
        2680
      ],
      "id": "3ceb5e20-b5e9-49cc-8080-f3c98a6565ef",
      "name": "Split Members"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const item = $input.item.json;\nconst pd = item.participant_details || {};\nconst recipientName = (pd.recipient_name || item.first_name || 'there').trim();\nconst bookerName = (pd.booker_name || '-').trim();\nconst giftUrl = (pd.gift_url || 'https://app.supershyft.com').trim();\nconst body = `Hello ${recipientName},\n\nThis Diwali we have a little surprise for you from someone who cares about you deeply.\n\n${bookerName} has chosen to gift you a personalised BIO AI Wellness Assessment because they want you to prioritise your health and take a little time for yourself.\n\nLife gets busy with work family and everything in between and sometimes we forget to look after ourselves.\n\nThis gift is a gentle reminder that your health matters and that the people who love you want to see you happy healthy and around for many more Diwalis together.\n\nThrough personalised BIO AI insights you can learn more about your health and discover recommendations to help you make informed choices for your well being.\n\nYour special gift is waiting for you here.\n\n${giftUrl}\n\nWe hope this little gesture brings a smile to your face and reminds you how deeply you are loved.\n\nWishing you and your family a Diwali filled with good health happiness and beautiful moments together.\n\nWith warmth and love\n\nTeam Supershyft`;\nreturn { json: { notification_id: item.notification_id, to: item.email, subject: 'A special Diwali gift for you from Supershyft', body } };"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        5240,
        2680
      ],
      "id": "5f94c4f6-890b-4d4d-8f20-e2998436fd64",
      "name": "Prepare Email"
    },
    {
      "parameters": {
        "fromEmail": "support@supershyft.com",
        "toEmail": "={{ $json.to }}",
        "subject": "={{ $json.subject }}",
        "emailFormat": "text",
        "text": "={{ $json.body }}",
        "options": {
          "appendAttribution": false
        }
      },
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        5460,
        2680
      ],
      "id": "f743612c-5ace-48c2-b5b2-6292a6c3044f",
      "name": "Send Email",
      "retryOnFail": true,
      "waitBetweenTries": 3000,
      "credentials": {
        "smtp": {
          "id": "eCub7Y6RwBvqnurK",
          "name": "SMTP account"
        }
      },
      "onError": "continueErrorOutput"
    },
    {
